# Copy to .env for local development. Production values are set in Render (API) and Vercel (web).

# ---- API (local and Render) ----------------------------------------------------------------
# Postgres. Local docker below. Neon: paste the DIRECT (non-pooled) connection string; a plain
# postgresql://...?sslmode=require URL is accepted and converted for asyncpg (ssl=require).
DATABASE_URL=postgresql+asyncpg://pratyay:pratyay@localhost:5432/pratyay
# development locally; production on Render.
APP_ENV=development
# "Act as" stand-in (development only, or with ALLOW_ROLE_SWITCHER=true): the role used when no
# role is picked in the masthead and there is no signed-in session.
DEV_USER_ROLE=maker
# true lets the "Act as" stand-in work outside development. It never overrides a real session.
# Keep false in production so every page needs sign-in.
ALLOW_ROLE_SWITCHER=false
# Sessions: idle timeout (matches the masthead timer) and absolute limit per sign-in.
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
# Failed sign-ins before an account is locked, and for how many minutes.
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Password the seed sets on the six Lender A users (uv run python -m app.seed_all). Required by
# the seed, at least 12 characters. Never commit a real value; the seed never prints it.
SEED_PASSWORD=
# The web origin allowed by CORS. Render: the Vercel URL, e.g. https://<project>.vercel.app
ALLOWED_ORIGIN=http://localhost:3000
# Optional: path to the trained classifier. Unset uses ml/obligation/models/obligation.joblib
# (the Docker image trains it there during the build).
OBLIGATION_MODEL_PATH=
# Render sets PORT itself; the container binds to it (default 8000).
SECRET_KEY=

# Signing (Pulkit)
SIGNING_KEY_PATH=./secrets/signing_key.pem
SIGNING_KEY_PASSPHRASE=

# Mail (local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- Web (local and Vercel) ----------------------------------------------------------------
# Where /api/* is forwarded. Vercel: the Render URL, e.g. https://<service>.onrender.com
API_URL=http://localhost:8000
# Shows the role switcher in the masthead. development locally only.
NEXT_PUBLIC_APP_ENV=development
# true shows the "Act as" switcher on the deployed site and lets pages open without a session.
# Must match ALLOW_ROLE_SWITCHER on the API. Default false.
NEXT_PUBLIC_ALLOW_ROLE_SWITCHER=false
# Mobile OTP sign-up and the authenticator step (samples until the identity owner wires them).
# false: Apply and the borrower links go to /sign-in, and /sign-up redirects there.
NEXT_PUBLIC_ENABLE_OTP=false

# Pratyay data protection (generate independent random 32-byte Base64 keys; store in secret manager)
DATA_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=

# ML-DSA-65 ledger signing keys (generate inside the PQC-enabled API image; never commit)
LEDGER_MLDSA_PUBLIC_KEY=
LEDGER_MLDSA_PRIVATE_KEY=
